{
  "sourceLanguage": "en",
  "strings": {
    " (updating…)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（更新中…）"
          }
        }
      }
    },
    "%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%"
          }
        }
      }
    },
    "%@ (%@ free on disk)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@ free on disk)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（磁盘可用空间 %2$@）"
          }
        }
