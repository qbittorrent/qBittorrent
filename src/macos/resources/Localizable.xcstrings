    "*": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "*"
          }
        }
      }
    },
    "-1: automatic, 0: disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "-1：自动，0：禁用"
          }
        }
      }
    },
    "-1: unlimited. Saving resume data is not limited by it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "-1：不限。保存恢复数据不受此限制。"
          }
        }
      }
    },
    ".torrent file copies": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".torrent 文件副本"
          }
        }
      }
    },
    ".torrent file size limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".torrent 文件大小上限"
          }
        }
      }
    },
    ".torrent files saved in these folders are added automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到这些文件夹的 .torrent 文件会被自动添加。"
          }
        }
      }
    },
    "0": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0"
          }
        }
      }
    },
    "0 failed logins means never ban, 0 seconds means sessions don't end, and 0 sessions means unlimited.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败登录次数为 0 表示从不封禁，0 秒表示会话永不过期，会话数为 0 表示不限。"
          }
        }
      }
    },
    "0 means unlimited.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 表示不限制。"
          }
        }
      }
    },
    "0: disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0：禁用"
          }
        }
      }
    },
    "0: listening port. Takes effect after a restart.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0：使用监听端口。重启后生效。"
          }
        }
      }
    },
    "0: permanent lease": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0：永久租约"
          }
        }
      }
    },
    "0: system default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0：系统默认值"
          }
        }
      }
    },
    "192.168.0.1 or 10.0.0.0/8": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "192.168.0.1 或 10.0.0.0/8"
          }
        }
      }
    },
    "A category named “%@” already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有名为“%@”的分类。"
          }
        }
      }
    },
    "A rule named “%@” already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有名为“%@”的规则。"
          }
        }
      }
    },
    "A rule needs a name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则需要名称。"
          }
        }
      }
    },
    "A torrent is slow when both its download and upload rates stay below these for that long.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种子的下载和上传速度在这段时间内都低于这些值时，视为慢速种子。"
          }
        }
      }
    },
    "A tracker answered with an error, for example that the torrent is not registered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracker 返回了错误，例如该 Torrent 未注册。"
          }
        }
      }
    },
