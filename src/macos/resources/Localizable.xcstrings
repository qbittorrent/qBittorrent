    },
    "%@ (this app)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（本应用）"
          }
        }
      }
    },
    "%@ · %lld results": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld results"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 条结果"
          }
        }
      }
    },
    "%@%@ · Tier %d · Seeds %@ · Leechers %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@ · Tier %3$d · Seeds %4$@ · Leechers %5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@ · 层级 %3$d · 种子 %4$@ · 下载者 %5$@"
          }
        }
      }
    },
    "%@/s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/s"
          }
        }
      }
    },
    "%lld of %lld files selected, %@ of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld files selected, %3$@ of %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %1$lld/%2$lld 个文件，%3$@/%4$@"
          }
        }
      }
    },
    "%lld of %lld results": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld results"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 条结果"
          }
