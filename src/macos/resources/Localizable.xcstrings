      }
    },
    "Also called automatic torrent management. Changing a torrent's category then moves its files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即“自动 Torrent 管理”。之后更改 Torrent 的分类时，文件也会随之移动。"
          }
        }
      }
    },
    "Also filter trackers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时过滤 Tracker"
          }
        }
      }
