{
  "name": "webui",
  "description": "qBittorrent WebUI",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/qbittorrent/qBittorrent.git"
  },
  "scripts": {
    "format": "js-beautify -r *.mjs private/*.html private/scripts/*.js private/views/*.html public/*.html public/scripts/*.js test/*/*.js && prettier --write **.css",
    "lint": "eslint --cache *.mjs private/*.html private/scripts/*.js private/views/*.html public/*.html public/scripts/*.js test/*/*.js && stylelint --cache **/*.css && html-validate private public",
    "test": "vitest run --dom"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-qbt-webui": "https://github.com/Chocobo1/eslint-plugin-qbt-webui/tarball/be8a8d78b9b0740436b3fafc001838998ea5aeb4",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-unicorn": "^79.0.0",
    "happy-dom": "^21.0.4",
    "html-validate": "^11.18.0",
    "js-beautify": "^2.0.3",
    "prettier": "3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "vitest": "^5.1.0"
  }
}
